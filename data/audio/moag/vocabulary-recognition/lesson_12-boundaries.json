    },
    {
      "start": 488.41,
      "end": 489.45,
      "text": " Listening Practice."
    },
    {
      "start": 490.37,
      "end": 494.63,
      "text": " Listen to the conversation enacted at a slightly slower than normal speed."
    },
    {
      "start": 496.81,
      "end": 498.81,
      "text": " Your daughter is not well."
    },
    {
      "start": 499.97,
      "end": 503.37,
      "text": " Oh, I didn't know that. What is the problem?"
    },
    {
      "start": 504.33,
      "end": 505.41,
      "text": " She is not well."
    },
    {
      "start": 506.19,
      "end": 508.91,
      "text": " She said she wants to take her to the hospital this evening."
    },
    {
      "start": 510.91,
      "end": 512.89,
      "text": " But I have a lot of work today."
    },
    {
      "start": 513.51,
      "end": 515.91,
      "text": " So I have to go to the office again this evening."
    },
    {
      "start": 516.91,
      "end": 517.89,
      "text": " Can you take her?"
    },
    {
      "start": 519.47,
      "end": 521.55,
      "text": " I want to watch a movie this evening."
    },
    {
      "start": 522.15,
      "end": 523.33,
      "text": " Can I take her tomorrow?"
    },
    {
      "start": 524.59,
      "end": 526.13,
      "text": " You don't want to watch a movie today."
    },
    {
      "start": 526.81,
      "end": 529.51,
      "text": " You have to take her to the hospital today itself."
    },
    {
      "start": 530.29,
      "end": 531.83,
      "text": " Otherwise, she will be in more trouble."
    },
    {
      "start": 533.15,
      "end": 535.89,
      "text": " Okay. But can you take me to the cinema tomorrow?"
    },
    {
      "start": 537.41,
      "end": 538.53,
      "text": " I have to take you."
    },
    {
      "start": 539.23,
      "end": 541.31,
      "text": " I have a lot of work this week."
    },
    {
      "start": 542.13,
      "end": 543.97,
      "text": " You can go with the kids, right?"
    },
    {
      "start": 545.03,
      "end": 546.09,
      "text": " Let it be so."
    },
    {
      "start": 546.83,
      "end": 549.51,
      "text": " Before you go to the office, let me bring coffee."
