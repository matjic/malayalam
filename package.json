{
    "scripts": {
        "docs:epub": "python3 scripts/build-epub.py",
        "docs:audio": "python3 scripts/integrate-moag-audio.py",
        "docs:check-audio": "python3 scripts/integrate-moag-audio.py --check",
        "docs:word-audio": "python3 scripts/build-vocabulary-audio.py",
        "docs:check-word-audio": "python3 scripts/build-vocabulary-audio.py --check && python3 scripts/test_audio_row_alignment.py",
        "docs:letter-audio": "python3 scripts/build-letter-audio.py",
        "docs:check-letter-audio": "python3 scripts/build-letter-audio.py --check",
        "dev": "cargo run --locked -- site && cargo run --locked -- serve",
        "docs:sidebar": "cargo run --locked -- sidebar",
        "docs:check-sidebar": "cargo run --locked -- sidebar --check",
        "docs:navigation": "python3 scripts/generate-reading-navigation.py && cargo run --locked -- sidebar",
        "docs:check-navigation": "python3 scripts/generate-reading-navigation.py --check && cargo run --locked -- sidebar --check",
        "docs:check-reading": "python3 scripts/validate-reading.py",
        "docs:writing": "python3 scripts/build-writing-symbols.py",
        "docs:check-writing": "python3 scripts/build-writing-symbols.py --check && python3 scripts/validate-writing-symbols.py",
        "docs:vocabulary": "python3 scripts/build-vocabulary-catalog.py",
        "docs:check-vocabulary": "python3 scripts/build-vocabulary-catalog.py --check && python3 scripts/test_vocabulary_ids.py && python3 scripts/test_vocabulary_tables.py",
        "test": "cargo test --locked && bun test tests/legacy-routes.test.js && python3 -m unittest discover -s scripts -p 'test_vocabulary*.py' && python3 scripts/test_anki_export.py && python3 scripts/test_audio_row_alignment.py",
        "docs:anki": "python3 scripts/build-vocabulary-catalog.py && python3 scripts/build-anki.py",
        "docs:check-anki": "python3 scripts/build-vocabulary-catalog.py --check && python3 scripts/test_anki_export.py && python3 scripts/test_anki.py",
        "docs:glossary": "python3 scripts/build-vocabulary-catalog.py && python3 scripts/build-vocabulary-glossary.py",
        "docs:check-glossary": "python3 scripts/build-vocabulary-catalog.py --check && python3 scripts/build-vocabulary-glossary.py --check",
        "docs:pdf": "python3 scripts/build-pdf.py",
        "docs:check-pdf": "python3 scripts/test_pdf_layout.py && python3 scripts/validate-pdf.py",
        "docs:check-lists": "python3 scripts/check-list-structure.py",
        "dev:legacy": "docsify serve ./docs",
        "docs:site": "cargo run --locked -- site",
        "docs:check-site": "cargo run --locked -- check-site"
    },
    "dependencies": {
        "docsify-cli": "^4.4.3"
    },
    "name": "malu-project",
    "version": "1.0.0",
    "main": "index.js",
    "repository": "git@github.com:matjic/malu-project.git",
    "author": "matjic",
    "license": "CC-BY-NC-SA-4.0",
    "private": false,
    "packageManager": "bun@1.3.10"
}
